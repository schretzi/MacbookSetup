# Vendor/auto-generated content that changes on every run of the tool that
# owns it. Tracking it just creates permanent diff noise with nothing to
# review - keep it on disk (still symlinked/copied by Ansible where needed)
# but out of git.

# Raycast Store extensions: installed and rebuilt by Raycast itself
# (compiled .js/.js.map + package.json, no source of ours involved).
Dotfiles/raycast/extensions/

# lazy.nvim's plugin lockfile: rewritten on every `:Lazy update`.
Dotfiles/neobean/lazy-lock.json

# Per-machine personal config: real identity and feature selection. Never
# meant to be shared/committed - copy the *.example.yml instead, or generate
# features.yml with Scripts/select-features.py.
Ansible/local/identity.yml
Ansible/local/features.yml

# Raycast runtime state. ~/.config/raycast is a symlink into Dotfiles/raycast,
# so Raycast writes its installed extensions and node compile cache straight
# into this working tree - 918M of it, none of it configuration. Same category
# as the caches listed in Ansible/roles/ai/defaults/main.yml.
Dotfiles/raycast/
