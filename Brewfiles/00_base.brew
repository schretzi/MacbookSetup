# Terminal
cask "kitty"

# Windowmanager
brew "koekeishiya/formulae/yabai"

# Keymappers
brew "koekeishiya/formulae/skhd" # for yabai
# No brew "kanata" here on purpose. kanata comes from `cargo install kanata
# --features cmd` (kanata role) because the Homebrew bottle is built without
# the cmd feature, which the keymap relies on. Having both installed only
# means /opt/homebrew/bin shadows ~/.cargo/bin in PATH, so an interactive
# `kanata` would run a different build than the daemon does.
# Wake-event watcher: re-grabs the keyboard for kanata after sleep/wake, since
# kanata's macOS backend never rescans devices on its own (kanata role,
# com.schretzi.kanata-wake LaunchDaemon).
brew "sleepwatcher"

# Neovim
brew "neovim"

# Better Spotlight
cask "raycast"

# Shell Tools
brew "fzf"
brew "zoxide"
brew "bat"
brew "btop"
brew "eza"
brew "nnn"
brew "direnv"
brew "starship"
brew "gnu-sed"
brew "grep"
brew "tree"
brew "ipcalc"
brew "watch"
brew "ripgrep"

# Parsers
brew "jq"
brew "yq"

# Fonts
cask "font-meslo-lg-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-source-code-pro"
cask "font-hack-nerd-font"
cask "font-fira-code-nerd-font"

# Network
brew "telnet"
