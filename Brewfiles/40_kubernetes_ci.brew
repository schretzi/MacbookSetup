# Local Kubernetes
brew "cmctl"          # cert-manager CLI, checks issuer/cert state
brew "hubble"         # Cilium flow visibility; worth having when gateway routing misbehaves
brew "kubeconform"

# Container runtime - replaces apple/container (and kiac) for LocalKubernetes'
# host containers (registry/gitea/openbao/postgres/gtt, see its
# compose/README.md). Configured by roles/docker_desktop: proxy, autostart,
# kiac root CA trust.
cask "docker-desktop"


# Container images
brew "hadolint"       # Dockerfile linter; `container build` has no --check like docker does
brew "ko"             # Dockerfile-free OCI images for Go services: distroless + nonroot by default
brew "trivy"          # image CVE scanner; run it with --ignore-unfixed or the output is noise
brew "syft"           # SBOM generator; `container build` has no --sbom, so this is the substitute

# Local CI
brew "go-task"

# IaC
brew "pulumi"
brew "hashicorp/tap/terraform"
brew "terragrunt"


# DB Tools
cask "dbeaver-community"

# Kubernetes
brew "k3d"
brew "kubernetes-cli"
brew "k9s"
brew "kubectx"
brew "kube-ps1"
cask "openlens"
brew "helm"
brew "helm-ls"
brew "istioctl"
brew "kustomize"
brew "kubelogin"
brew "krew"

## Lang Servers
brew "bash-language-server"
brew "dockerfile-language-server"
brew "lua-language-server"
brew "yaml-language-server"

# CNCF-Tools
brew "argocd"
brew "hashicorp/tap/vault"
