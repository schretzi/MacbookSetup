local_proxy:
  host: 127.0.0.1
  port: 3128
  no_proxy:
    - localhost
    - 127.0.0.1
    - ::1
    - kubernetes
    # The cluster's short name. Go's no_proxy matching is label-suffix based,
    # so `kiac` covers `kiac` and `*.kiac` only - the Gateway hosts are
    # `<app>.apps.main.kiac.schretzi.net` and need the FQDN suffix as well.
    - kiac
    # apple/container's own host-native pull daemon (container-core-images)
    # builds its PAC bypass from this list too, and its no_proxy matcher does
    # NOT treat bare `kiac` as a suffix wildcard the way Go does - without the
    # explicit dotted form, registry.kiac/gitea.kiac/openbao.kiac/... (every
    # *.kiac host except the literal short name itself) gets proxied and
    # fails with HTTPClientError.invalidProxyResponse. filter_proxy.direct
    # below already has this; local_proxy.no_proxy was missing it.
    - .kiac
    - .kiac.schretzi.net
  # Agents that read the proxy from their launchd environment. launchd does not
  # source the shell's rc files, so they only see a proxy because macswitcher
  # publishes one with `launchctl setenv` - and only ever the value that was
  # published before they started. Restarting them is the whole mechanism.
  #
  # tunneling is here because its IAP dialer reaches Google through Go's
  # http.DefaultTransport. Without a proxy in its environment it resolves
  # oauth2.googleapis.com itself and fails every tunnel with "no such host",
  # which reads like broken DNS and is not.
  restart_agents:
    - tunneling
alpaca:
  enabled: true
  command:
    - alpaca
    - -l
    - "{{local_host}}"
    - -p
    - "{{local_port}}"
    - -C
    - "{{pac_file}}"
network_services: []

# The filtering proxy alpaca forwards to in direct contexts - privoxy, from
# the privoxy role. Only direct contexts: a forward context talks to the
# corporate proxy, which filters already.
#
# macswitcher generates the PAC from this block plus local_proxy.no_proxy and
# starts alpaca with it. Do not hand-write a PAC and name it through a
# context's alpaca.command - `config validate` warns about exactly that,
# because the two lists then drift apart.
#
# fail_open: privoxy down means unfiltered browsing rather than no network.
# `macswitcher status` and the privoxy row in `observe` are what tell you it
# is happening; without them the fail-open is silent.
filter_proxy:
  enabled: true
  host: 127.0.0.1
  port: 8118
  fail_open: true
  direct:
    - .kiac
    - .kiac.schretzi.net
    - .ts.net
    - localhost
    - kubernetes
    # gcloud verifies via Python/certifi, which ignores the macOS System
    # keychain and therefore rejects the Privoxy HTTPS-inspection CA.
    - .googleapis.com
    # Snowflake account hosts may contain an underscore (corp-corp_main1).
    # Privoxy links against OpenSSL, whose wildcard matching only accepts
    # [A-Za-z0-9-] for characters covered by `*`, so `*.snowflakecomputing.com`
    # is rejected as "hostname mismatch". Browsers accept it; Privoxy cannot.
    - .snowflakecomputing.com

dns:
  local_resolver: 127.0.0.2
unbound:
  forwarders_file: /opt/homebrew/etc/unbound/conf.d/forwarders.conf
daemons:
  unbound:
    label: sh.brew.unbound
    scope: system
    # Without these, observe's s/h/R/e/d keys fall back to the generic
    # system-scope path, which wraps everything in `sudo sh -c "launchctl
    # ..."` - sudo then matches the command as /bin/sh, so no sudoers rule
    # naming the real launchctl invocation can ever apply, and every action
    # prompts for a password (see the kanata entry below for the same fix).
    # Each override embeds its own `sudo -n` so *that* exact argv is what
    # sudo (and sudoers) actually sees.
    start_command: sudo -n /bin/launchctl bootstrap system /Library/LaunchDaemons/sh.brew.unbound.plist
    stop_command: sudo -n /bin/launchctl bootout system /Library/LaunchDaemons/sh.brew.unbound.plist
    restart_command: sudo -n /bin/launchctl kickstart -k system/sh.brew.unbound
  kerberos_keep_alive:
    label: com.schretzi.kerberoskeepalive
  omt:
    label: com.schretzi.omt
    status_command: omt status
[% if work_vpn_label | default('') | length > 0 %]
  vpn:
    label: [[ work_vpn_label ]]
    interface: utun99
    status_command: ifconfig utun99 2>/dev/null | grep -q 'inet ' && echo "tunnel up" || echo "tunnel down"
[% endif %]
  tunneling:
    label: com.schretzi.tunneling
    status_command: tunneling status --json 2>&1 || true
  privoxy:
    label: com.schretzi.privoxy
    status_command: nc -z 127.0.0.1 8118 && echo "listening on 127.0.0.1:8118" || echo "NOT listening on 127.0.0.1:8118"
  # ollama, the local LLM server (Ansible/roles/ollama). Listed here purely so
  # `observe` can see and control it - macswitcher has no built-in knowledge
  # of it, same as kanata below.
  #
  # All three *_command overrides are needed because this agent is
  # RunAtLoad=false: launchd keeps it registered and idle, so the generic
  # gui-scope path's bootstrap/bootout would only load and unload the job
  # without ever running the server. kickstart/kill act on the job that is
  # already loaded, which is also what makes start fast.
  #
  # status_command is `ollama ps` rather than a launchctl query for the same
  # reason: `launchctl print` succeeds for a loaded-but-idle job, so it would
  # report a server that is not listening as up. `ollama ps` answers the
  # question that matters - and its output names the model currently holding
  # RAM, which is the number worth seeing before starting anything else.
  #
  # Both trailing fallbacks are there so observe never shows a bare
  # "status_command failed" / "stop failed" for the ordinary case: `ollama ps`
  # exits 1 when the server is down, and `launchctl kill` exits 3 ("No process
  # to signal") when asked to stop something already stopped. Neither is an
  # error worth surfacing - stopped is a normal state for this job.
  ollama:
    label: com.schretzi.ollama
    status_command: [[ homebrew_prefix ]]/bin/ollama ps 2>/dev/null || echo "stopped"
    start_command: launchctl kickstart gui/$(id -u)/com.schretzi.ollama
    stop_command: launchctl kill SIGTERM gui/$(id -u)/com.schretzi.ollama 2>/dev/null || true
    restart_command: launchctl kickstart -k gui/$(id -u)/com.schretzi.ollama
  # kanata, the keymapper. macswitcher has no built-in knowledge of it; the
  # entry alone is enough to observe and control it.
  #
  # status_command uses an ABSOLUTE path on purpose. It runs through `sh -c`
  # from whatever process hosts the TUI, whose PATH is not guaranteed to be
  # the interactive shell's - and a status_command that misses only produces a
  # bare "status_command failed" in observe. The awk keeps the device table
  # (lines starting with a device hash) and drops kanata's configuration
  # example, which is the bulk of --list's output and not what we want here.
  #
  # The three *_command overrides exist because the generic system-scope path
  # builds `sudo sh -c "launchctl ..."`, which sudo matches as /bin/sh - so no
  # targeted sudoers rule could ever apply and every action would prompt for a
  # password. Called directly like this they match the kanata-service rule
  # (Ansible/roles/sudoers/defaults/main.yml) and run unattended.
  #
  # stop is bootout rather than `launchctl stop`: KeepAlive would restart a
  # stopped-but-loaded job immediately, and com.schretzi.kanata-wake would
  # kickstart it on the next wake regardless, since its guard only asks
  # whether the job is loaded.
  kanata:
    label: com.kanata.daemon
    scope: system
    status_command: >-
      [[ ansible_facts.env.HOME ]]/.cargo/bin/kanata --list 2>&1 |
      awk '/^0x/ { hash = $1; $1 = $2 = $3 = ""; sub(/^ +/, ""); printf "%-20s %s\n", hash, $0 }'
    start_command: sudo -n /bin/launchctl bootstrap system /Library/LaunchDaemons/com.kanata.daemon.plist
    stop_command: sudo -n /bin/launchctl bootout system /Library/LaunchDaemons/com.kanata.daemon.plist
    restart_command: sudo -n /bin/launchctl kickstart -k system/com.kanata.daemon
applications:
  docker:
    start:
      - open
      - -a
      - Docker
    stop:
      - osascript
      - -e
      - tell application "Docker" to quit
    restart:
      - sh
      - -c
      - osascript -e 'tell application "Docker" to quit' && open -a Docker
  streamdeck:
    start:
      - open
      - -a
      - Elgato Stream Deck
    stop:
      - osascript
      - -e
      - tell application "Elgato Stream Deck" to quit
  # privoxy and vpn have no `service` subcommand of their own (third-party /
  # script-based agents - see docs/networking-tools.md), so contexts control
  # them with raw launchctl against the gui domain. bootout/bootstrap, not
  # kill/kickstart, are used for start/stop: bootout is what actually removes
  # the job so KeepAlive does not just restart it (see the VPN plist
  # comment). `sh -c` (not a bare argv) so `$(id -u)` and `~` expand per-user.
  #
  # Both RunAtLoad, so they are already bootstrapped at login - a plain
  # `bootstrap`/`bootout` errors ("already loaded" / "not loaded") if a
  # context asks for a state the job is already in. `launchctl print` first
  # makes start/stop idempotent: start only bootstraps if not already
  # loaded, stop only boots out if it is.
  privoxy:
    start:
      - sh
      - -c
      - launchctl print gui/$(id -u)/com.schretzi.privoxy >/dev/null 2>&1 || launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.schretzi.privoxy.plist
    stop:
      - sh
      - -c
      - launchctl print gui/$(id -u)/com.schretzi.privoxy >/dev/null 2>&1 && launchctl bootout gui/$(id -u)/com.schretzi.privoxy || true
    restart:
      - sh
      - -c
      - launchctl kickstart -k gui/$(id -u)/com.schretzi.privoxy
[% if work_vpn_label | default('') | length > 0 %]
  vpn:
    start:
      - sh
      - -c
      - launchctl print gui/$(id -u)/[[ work_vpn_label ]] >/dev/null 2>&1 || launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/[[ work_vpn_label ]].plist
    stop:
      - sh
      - -c
      - launchctl print gui/$(id -u)/[[ work_vpn_label ]] >/dev/null 2>&1 && launchctl bootout gui/$(id -u)/[[ work_vpn_label ]] || true
    restart:
      - sh
      - -c
      - launchctl kickstart -k gui/$(id -u)/[[ work_vpn_label ]]
[% endif %]
  # kerberoskeepalive ships its own `service` subcommand - prefer it over raw
  # launchctl so plist path/label details stay owned by that tool.
  kerberos_keep_alive:
    start:
      - kerberoskeepalive
      - service
      - start
    stop:
      - kerberoskeepalive
      - service
      - stop
    restart:
      - kerberoskeepalive
      - service
      - restart
  # Same reasoning as kerberoskeepalive: tunneling owns its own plist, so let
  # its `service` subcommand own the restart. Named in local_proxy.restart_agents,
  # which is what actually invokes this.
  tunneling:
    start:
      - tunneling
      - service
      - start
    stop:
      - tunneling
      - service
      - stop
    restart:
      - tunneling
      - service
      - restart
