# "hyper" here is Ctrl+Shift+Alt+Cmd, held via Caps Lock (see Dotfiles/kanata/kanata.kbd).
# App switching lives on fn (kanata's "apps" layer, see kanata.kbd) - hyper is
# reserved for actions like this one, not app switching.

# Toggle mute/unmute in Microsoft Teams (brings Teams to front, then sends its
# in-app mute shortcut Cmd+Shift+M; adjust the keystroke below if your Teams
# version uses a different mute shortcut)
hyper - m : osascript -e 'tell application "Microsoft Teams" to activate' -e 'delay 0.2' -e 'tell application "System Events" to keystroke "m" using {command down, shift down}'

###############################################################################
#                          yabai window management
###############################################################################
# yabai has no hotkey system of its own - all of this just shells out to
# `yabai -m ...`. Space labels (desk1..desk10) are assigned once in
# Dotfiles/yabai/yabairc; keep the numbers below in sync with that file.
#
# Layout (see yabairc for the full breakdown/rationale):
#   desk1-4  MacBook screen (1 Teams, 2 passwords, 3 Little Snitch, 4 free)
#   desk5-7  Left external screen (5 Zen, 6-7 free)
#   desk8-10 Right external screen (8 kitty, 9 kitty session clones, 10 free)

# --- Cycle windows within the current app/space --------------------------
# NOTE: yabai's directional/stack focus (`window --focus west/south/...` or
# `stack.next`/`stack.prev`) requires its Scripting Addition, which in turn
# requires partially disabling SIP (System Integrity Protection). We're
# keeping SIP fully enabled, so those don't work and aren't used here.
# Instead h/l cycle through open windows of the frontmost app via macOS's
# own Cmd+`/Cmd+Shift+` window-cycling shortcut - this needs no SA/SIP
# change and works today. j/k are unused for now (no SA-free yabai
# equivalent for "focus other space's windows" exists).
hyper - h : osascript -e 'tell application "System Events" to keystroke "`" using {command down, shift down}'
hyper - l : osascript -e 'tell application "System Events" to keystroke "`" using {command down}'

# --- Switch directly to a space (desk1..desk10; "0" = desk10) ----------------
hyper - 1 : yabai -m space --focus desk1
hyper - 2 : yabai -m space --focus desk2
hyper - 3 : yabai -m space --focus desk3
hyper - 4 : yabai -m space --focus desk4
hyper - 5 : yabai -m space --focus desk5
hyper - 6 : yabai -m space --focus desk6
hyper - 7 : yabai -m space --focus desk7
hyper - 8 : yabai -m space --focus desk8
hyper - 9 : yabai -m space --focus desk9
hyper - 0 : yabai -m space --focus desk10

# --- Move the focused window to a space and follow it -----------------------
hyper + shift - 1 : yabai -m window --space desk1  && yabai -m space --focus desk1
hyper + shift - 2 : yabai -m window --space desk2  && yabai -m space --focus desk2
hyper + shift - 3 : yabai -m window --space desk3  && yabai -m space --focus desk3
hyper + shift - 4 : yabai -m window --space desk4  && yabai -m space --focus desk4
hyper + shift - 5 : yabai -m window --space desk5  && yabai -m space --focus desk5
hyper + shift - 6 : yabai -m window --space desk6  && yabai -m space --focus desk6
hyper + shift - 7 : yabai -m window --space desk7  && yabai -m space --focus desk7
hyper + shift - 8 : yabai -m window --space desk8  && yabai -m space --focus desk8
hyper + shift - 9 : yabai -m window --space desk9  && yabai -m space --focus desk9
hyper + shift - 0 : yabai -m window --space desk10 && yabai -m space --focus desk10
