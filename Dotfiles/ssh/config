# Managed by MacbookSetup - Ansible role "ssh"
# Truth lives in Dotfiles/ssh/config, symlinked to ~/.ssh/config
#
# Private keys are deliberately NOT in this repo. Create them per device and
# per usage (see Setup.md -> SSH), then add a matching Host block here.

Host *
    # Load the passphrase from the macOS keychain instead of prompting
    UseKeychain yes
    # Keep unlocked keys in ssh-agent for the rest of the session
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_mbm5_github
    IdentitiesOnly yes
