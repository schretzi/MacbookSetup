# Managed by MacbookSetup - Ansible role "ssh"
# Truth lives in Dotfiles/ssh/config, symlinked to ~/.ssh/config
#
# Private keys are deliberately NOT in this repo, and neither are per-host
# blocks that would name one (or an internal/work hostname) - see Setup.md ->
# SSH. Those live in the private and work overlays as
# ~/.ssh/config.d/{private,work}.conf, pulled in below. This file only holds
# generic client behavior that applies regardless of which overlays (if any)
# are cloned.

Include ~/.ssh/config.d/*.conf

Host *
    UseKeychain yes
    AddKeysToAgent yes
    ServerAliveInterval 240
    ServerAliveCountMax 3
    SetEnv TERM=xterm-256color
