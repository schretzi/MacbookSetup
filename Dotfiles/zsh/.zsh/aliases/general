alias "ll=eza -l"
alias "lli=eza -lia"
alias "vi=NVIM_APPNAME=neobean /opt/homebrew/bin/nvim"
alias "vim=NVIM_APPNAME=neobean /opt/homebrew/bin/nvim"

# Re-grabs the keyboard after it reconnects on a different transport (e.g.
# cable -> Bluetooth), which kanata otherwise doesn't notice - see Setup.md.
kanata_restart() {
  sudo -n /bin/launchctl kickstart -k system/com.kanata.daemon
}

alias flush_dns="sudo -n /usr/bin/dscacheutil -flushcache; sudo -n /usr/bin/killall -HUP mDNSResponder"

alias ws="cd ~/Workspace"
alias wss="cd ~/Workspace/Schretzi"
alias wsd="cd ~/Workspace/Schretzi/MacbookSetup/Dotfiles"
alias wsb="cd ~/Workspace/Schretzi/MacbookSetup/Brewfiles"

alias tf="terraform"
alias tg="terragrunt"

alias restart_kanata="sudo launchctl kickstart -k system/com.kanata.daemon"

alias f="fzf"
