# Manage per-cluster kubeconfigs under ~/.kube/configs/<name>/, each holding
# its own extracted ca.crt/client.crt/client.key and a `config` file that
# references them by full path - instead of one growing ~/.kube/config with
# every cluster's secrets embedded inline. See Setup.md -> Kubernetes.
#
# Workflow:
#   mkdir -p ~/.kube/configs/<name> && mv downloaded-kubeconfig.yaml $_
#   kubeconfig-add <name> [--server host:port] [--source <file>]
#   kubeconfig-merge
#   kubeconfig-use [name]   # switch cluster for this shell only, see below
#
# ~/.kube/configs itself is seeded by the `kubeconfig` Ansible role; everything
# under it is created and owned by these two functions.

# Extract the CA cert (and, when present, the client cert/key) from a
# downloaded kubeconfig into ~/.kube/configs/<name>/ and write a `config`
# there referencing them by full path. The cluster, context and user are all
# named <name>.
#
# Usage: kubeconfig-add <name> [--server <address>] [--source <file>]
#   <name>            matches the directory under ~/.kube/configs/ that
#                     already holds the downloaded kubeconfig
#   --server <addr>   override the cluster's server address (host:port),
#                     e.g. for a cluster only reachable through a tunnel
#   --source <file>   the downloaded kubeconfig to read, when the directory
#                     holds more than one and autodetection is ambiguous
#
# client-certificate-data/client-key-data are pulled out whenever present;
# many clusters use OIDC/exec/token auth instead, which has no cert or key to
# extract - the user entry is then copied through as-is (only the CA cert
# still moves to its own file, since that is usually the largest field).
kubeconfig-add() {
  emulate -L zsh

  local name="" server_override="" source_file=""
  while (( $# )); do
    case "$1" in
      --server) server_override="$2"; shift 2 ;;
      --source) source_file="$2"; shift 2 ;;
      -h | --help)
        echo "usage: kubeconfig-add <name> [--server <address>] [--source <file>]"
        return 0
        ;;
      -*)
        echo "kubeconfig-add: unknown option $1" >&2
        return 1
        ;;
      *)
        if [[ -n "${name}" ]]; then
          echo "kubeconfig-add: unexpected argument $1" >&2
          return 1
        fi
        name="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${name}" ]]; then
    echo "usage: kubeconfig-add <name> [--server <address>] [--source <file>]" >&2
    return 1
  fi

  if ! command -v yq >/dev/null || ! command -v kubectl >/dev/null; then
    echo "kubeconfig-add: needs both yq and kubectl on PATH" >&2
    return 1
  fi

  local dir="${HOME}/.kube/configs/${name}"
  if [[ ! -d "${dir}" ]]; then
    echo "kubeconfig-add: ${dir} does not exist - create it and put the downloaded kubeconfig in it first" >&2
    return 1
  fi

  # Autodetect the downloaded kubeconfig: skip our own output (config,
  # *.crt, *.key), then only consider files that actually parse as a
  # kubeconfig (kind: Config with a current-context) - a README, a macOS
  # alias, or a stray note in the same directory is never a candidate, no
  # matter how many of them sit next to the real file.
  if [[ -z "${source_file}" ]]; then
    local -a candidates all_files
    all_files=("${dir}"/*(.N))
    local f base
    for f in "${all_files[@]}"; do
      base="${f:t}"
      [[ "${base}" == "config" ]] && continue
      [[ "${base}" == *.crt || "${base}" == *.key ]] && continue
      if [[ "$(yq eval '.kind' "${f}" 2>/dev/null)" == "Config" ]] \
         && [[ "$(yq eval '."current-context"' "${f}" 2>/dev/null)" != "null" ]]; then
        candidates+=("${f}")
      fi
    done
    if (( ${#candidates[@]} == 0 )); then
      echo "kubeconfig-add: no kubeconfig file found in ${dir} - download the original into it first" >&2
      return 1
    elif (( ${#candidates[@]} > 1 )); then
      echo "kubeconfig-add: multiple kubeconfig files in ${dir}, specify which one with --source:" >&2
      printf '  %s\n' "${candidates[@]}" >&2
      return 1
    fi
    source_file="${candidates[1]}"
  fi

  if [[ ! -f "${source_file}" ]]; then
    echo "kubeconfig-add: ${source_file} not found" >&2
    return 1
  fi

  # Resolve through current-context rather than assuming a single cluster/user
  # entry - some downloads carry more than one.
  local current_context cluster_name user_name
  current_context=$(yq eval '."current-context"' "${source_file}")
  if [[ -z "${current_context}" || "${current_context}" == "null" ]]; then
    echo "kubeconfig-add: ${source_file} has no current-context set" >&2
    return 1
  fi
  cluster_name=$(yq eval ".contexts[] | select(.name == \"${current_context}\") | .context.cluster" "${source_file}")
  user_name=$(yq eval ".contexts[] | select(.name == \"${current_context}\") | .context.user" "${source_file}")

  # Whole cluster/user mappings, not individual fields - whatever auth method
  # (cert, token, exec, auth-provider/oidc) is in there passes through
  # untouched except for the fields extracted below.
  local cluster_yaml user_yaml
  cluster_yaml=$(yq eval ".clusters[] | select(.name == \"${cluster_name}\") | .cluster" "${source_file}")
  user_yaml=$(yq eval ".users[] | select(.name == \"${user_name}\") | .user" "${source_file}")

  local server ca_data cert_data key_data
  server=$(print -r -- "${cluster_yaml}" | yq eval '.server' -)
  ca_data=$(print -r -- "${cluster_yaml}" | yq eval '."certificate-authority-data"' -)
  cert_data=$(print -r -- "${user_yaml}" | yq eval '."client-certificate-data"' -)
  key_data=$(print -r -- "${user_yaml}" | yq eval '."client-key-data"' -)

  [[ -n "${server_override}" ]] && server="${server_override}"
  cluster_yaml=$(print -r -- "${cluster_yaml}" | yq eval ".server = \"${server}\"" -)

  chmod 700 "${dir}"

  local ca_path=""
  if [[ -n "${ca_data}" && "${ca_data}" != "null" ]]; then
    ca_path="${dir}/ca.crt"
    print -r -- "${ca_data}" | base64 --decode > "${ca_path}"
    chmod 644 "${ca_path}"
    cluster_yaml=$(print -r -- "${cluster_yaml}" \
      | yq eval "del(.\"certificate-authority-data\") | .\"certificate-authority\" = \"${ca_path}\"" -)
  fi

  local have_cert_key=false
  if [[ -n "${cert_data}" && "${cert_data}" != "null" && -n "${key_data}" && "${key_data}" != "null" ]]; then
    have_cert_key=true
    local cert_path="${dir}/client.crt" key_path="${dir}/client.key"
    print -r -- "${cert_data}" | base64 --decode > "${cert_path}"
    print -r -- "${key_data}" | base64 --decode > "${key_path}"
    chmod 644 "${cert_path}"
    chmod 600 "${key_path}"
    user_yaml=$(print -r -- "${user_yaml}" \
      | yq eval "del(.\"client-certificate-data\") | del(.\"client-key-data\") | .\"client-certificate\" = \"${cert_path}\" | .\"client-key\" = \"${key_path}\"" -)
  fi

  local cluster_frag user_frag
  cluster_frag=$(mktemp) && user_frag=$(mktemp)
  print -r -- "${cluster_yaml}" > "${cluster_frag}"
  print -r -- "${user_yaml}" > "${user_frag}"

  yq eval -n "
      .apiVersion = \"v1\"
    | .kind = \"Config\"
    | .\"current-context\" = \"${name}\"
    | .clusters[0].name = \"${name}\"
    | .clusters[0].cluster = load(\"${cluster_frag}\")
    | .contexts[0].name = \"${name}\"
    | .contexts[0].context.cluster = \"${name}\"
    | .contexts[0].context.user = \"${name}\"
    | .users[0].name = \"${name}\"
    | .users[0].user = load(\"${user_frag}\")
  " > "${dir}/config"
  rm -f "${cluster_frag}" "${user_frag}"
  chmod 600 "${dir}/config"

  if ! kubectl config view --kubeconfig "${dir}/config" >/dev/null 2>&1; then
    echo "kubeconfig-add: generated ${dir}/config does not parse - check it by hand" >&2
    return 1
  fi

  echo "Wrote ${dir}/config (context '${name}', server ${server})"
  if [[ -z "${ca_path}" ]]; then
    echo "kubeconfig-add: no CA certificate found - TLS verification may fail" >&2
  fi
  if [[ "${have_cert_key}" == false ]]; then
    echo "kubeconfig-add: no client-certificate-data/client-key-data - kept the original auth method (token/exec/oidc) as-is" >&2
  fi
  echo "Run \`kubeconfig-merge\` to add it to ~/.kube/config"
}

# Merge every ~/.kube/configs/*/config into ~/.kube/config, keeping the
# certificate-authority/client-certificate/client-key entries as file paths
# rather than embedding them - ~/.kube/config stays small and secret-free.
# The original downloaded kubeconfigs and any other files in each
# subdirectory are ignored; only the file literally named `config` (written
# by kubeconfig-add) is read.
kubeconfig-merge() {
  emulate -L zsh

  if ! command -v kubectl >/dev/null; then
    echo "kubeconfig-merge: kubectl not found on PATH" >&2
    return 1
  fi

  local configs_dir="${HOME}/.kube/configs"
  local target="${HOME}/.kube/config"
  local -a sources
  sources=("${configs_dir}"/*/config(N))

  if (( ${#sources[@]} == 0 )); then
    echo "kubeconfig-merge: no config files found under ${configs_dir}/*/config - run kubeconfig-add first" >&2
    return 1
  fi

  # Preserve whichever context was active, so merging in a new cluster does
  # not silently switch the current one.
  local previous_context=""
  if [[ -f "${target}" ]]; then
    previous_context=$(kubectl config view --kubeconfig "${target}" -o jsonpath='{.current-context}' 2>/dev/null)
  fi

  local kubeconfig_path
  kubeconfig_path=$(IFS=:; echo "${sources[*]}")

  local tmp
  tmp=$(mktemp "${target}.XXXXXX") || return 1
  # No --flatten: that would embed every cert/key inline again, which is
  # exactly what the per-cluster subdirectories exist to avoid.
  if ! KUBECONFIG="${kubeconfig_path}" kubectl config view > "${tmp}"; then
    rm -f "${tmp}"
    echo "kubeconfig-merge: kubectl config view failed" >&2
    return 1
  fi

  if [[ -n "${previous_context}" ]] \
     && KUBECONFIG="${tmp}" kubectl config get-contexts -o name 2>/dev/null | grep -qx -- "${previous_context}"; then
    KUBECONFIG="${tmp}" kubectl config use-context "${previous_context}" >/dev/null
  fi

  if [[ -f "${target}" ]]; then
    cp "${target}" "${target}.bak-$(date +%Y%m%dT%H%M%S)"
  fi

  chmod 600 "${tmp}"
  mv "${tmp}" "${target}"

  echo "Merged ${#sources[@]} cluster config(s) from ${configs_dir} into ${target}"
}

# Point KUBECONFIG at a single cluster's own ~/.kube/configs/<name>/config
# for the current shell only - unlike `kubectx`, which rewrites
# current-context in the shared, merged ~/.kube/config for every shell.
# Since each per-cluster config already has current-context set to <name>,
# pointing KUBECONFIG at it is all that's needed; nothing is written to disk.
#
# Usage:
#   kubeconfig-use            interactive picker (fzf if installed, a
#                              numbered `select` menu otherwise) - both just
#                              scroll/paginate the list, no typing required
#   kubeconfig-use <name>      switch straight to <name> (tab-completes)
#   kubeconfig-use -           unset KUBECONFIG, back to the merged config
kubeconfig-use() {
  emulate -L zsh

  local configs_dir="${HOME}/.kube/configs"

  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "usage: kubeconfig-use [name|-]"
    echo "  (no argument)  pick interactively (fzf if installed, else a numbered menu)"
    echo "  <name>         point KUBECONFIG at ${configs_dir}/<name>/config, this shell only"
    echo "  -              unset KUBECONFIG, fall back to the merged ~/.kube/config"
    return 0
  fi

  if [[ "$1" == "-" ]]; then
    unset KUBECONFIG
    echo "kubeconfig-use: back to the merged ~/.kube/config"
    return 0
  fi

  local -a names
  names=("${configs_dir}"/*/config(N:h:t))
  if (( ${#names[@]} == 0 )); then
    echo "kubeconfig-use: no config files found under ${configs_dir}/*/config - run kubeconfig-add first" >&2
    return 1
  fi

  local name="$1"
  if [[ -z "${name}" ]]; then
    local current=""
    [[ "${KUBECONFIG}" == "${configs_dir}"/*/config ]] && current="${KUBECONFIG:h:t}"

    if command -v fzf >/dev/null; then
      name=$(printf '%s\n' "${names[@]}" | fzf --height=~40% --cycle \
        --header="kubeconfig-use  (current: ${current:-merged ~/.kube/config})" \
        --prompt="cluster> ")
    else
      # No fzf: zsh's builtin `select` still lists/scrolls by number, just
      # without fuzzy filtering.
      local REPLY
      PS3="cluster> "
      select name in "${names[@]}"; do
        break
      done
    fi
    [[ -z "${name}" ]] && return 1
  fi

  if [[ ! -r "${configs_dir}/${name}/config" ]]; then
    echo "kubeconfig-use: no config for '${name}' - see \`kubeconfig-use\` for the list" >&2
    return 1
  fi

  export KUBECONFIG="${configs_dir}/${name}/config"
  echo "KUBECONFIG set to '${name}' for this shell (unset with \`kubeconfig-use -\`)"
}

_kubeconfig_names() {
  local -a names
  names=("${HOME}"/.kube/configs/*(/N:t))
  compadd -- "${names[@]}"
}
(( $+functions[compdef] )) && compdef _kubeconfig_names kubeconfig-add

_kubeconfig_use_names() {
  local -a names
  names=("${HOME}"/.kube/configs/*/config(N:h:t))
  compadd -- "${names[@]}" -
}
(( $+functions[compdef] )) && compdef _kubeconfig_use_names kubeconfig-use kubects
