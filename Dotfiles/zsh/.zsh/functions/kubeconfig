# Manage per-cluster kubeconfigs under ~/.kube/configs/<name>/, each holding
# its own extracted ca.crt/client.crt/client.key and a `config` file that
# references them by full path - instead of one growing ~/.kube/config with
# every cluster's secrets embedded inline. See Setup.md -> Kubernetes.
#
# Workflow:
#   mkdir -p ~/.kube/configs/<name> && mv downloaded-kubeconfig.yaml $_
#   kubeconfig-add <name> [--server host:port] [--source <file>]
#   kubeconfig-merge
#
# ~/.kube/configs itself is seeded by the `kubeconfig` Ansible role; everything
# under it is created and owned by these two functions.

# Extract the embedded CA/client cert/key from a downloaded kubeconfig into
# ~/.kube/configs/<name>/ and write a `config` there referencing them by full
# path. The cluster, context and user are all named <name>.
#
# Usage: kubeconfig-add <name> [--server <address>] [--source <file>]
#   <name>            matches the directory under ~/.kube/configs/ that
#                     already holds the downloaded kubeconfig
#   --server <addr>   override the cluster's server address (host:port),
#                     e.g. for a cluster only reachable through a tunnel
#   --source <file>   the downloaded kubeconfig to read, when the directory
#                     holds more than one file and autodetection is ambiguous
#
# Only client-certificate/client-key auth is handled - a kubeconfig using a
# bearer token or an exec plugin has nothing for this to extract.
kubeconfig-add() {
  emulate -L zsh

  local name="" server_override="" source_file=""
  while (( $# )); do
    case "$1" in
      --server) server_override="$2"; shift 2 ;;
      --source) source_file="$2"; shift 2 ;;
      -h | --help)
        echo "usage: kubeconfig-add <name> [--server <address>] [--source <file>]"
        return 0
        ;;
      -*)
        echo "kubeconfig-add: unknown option $1" >&2
        return 1
        ;;
      *)
        if [[ -n "${name}" ]]; then
          echo "kubeconfig-add: unexpected argument $1" >&2
          return 1
        fi
        name="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${name}" ]]; then
    echo "usage: kubeconfig-add <name> [--server <address>] [--source <file>]" >&2
    return 1
  fi

  if ! command -v yq >/dev/null || ! command -v kubectl >/dev/null; then
    echo "kubeconfig-add: needs both yq and kubectl on PATH" >&2
    return 1
  fi

  local dir="${HOME}/.kube/configs/${name}"
  if [[ ! -d "${dir}" ]]; then
    echo "kubeconfig-add: ${dir} does not exist - create it and put the downloaded kubeconfig in it first" >&2
    return 1
  fi

  # Autodetect the downloaded kubeconfig: anything in the directory that is
  # not already-generated output.
  if [[ -z "${source_file}" ]]; then
    local -a candidates all_files
    all_files=("${dir}"/*(.N))
    local f base
    for f in "${all_files[@]}"; do
      base="${f:t}"
      [[ "${base}" == "config" ]] && continue
      [[ "${base}" == *.crt || "${base}" == *.key ]] && continue
      candidates+=("${f}")
    done
    if (( ${#candidates[@]} == 0 )); then
      echo "kubeconfig-add: no kubeconfig file found in ${dir} - download the original into it first" >&2
      return 1
    elif (( ${#candidates[@]} > 1 )); then
      echo "kubeconfig-add: multiple files in ${dir}, specify which one with --source:" >&2
      printf '  %s\n' "${candidates[@]}" >&2
      return 1
    fi
    source_file="${candidates[1]}"
  fi

  if [[ ! -f "${source_file}" ]]; then
    echo "kubeconfig-add: ${source_file} not found" >&2
    return 1
  fi

  # Resolve through current-context rather than assuming a single cluster/user
  # entry - some downloads carry more than one.
  local current_context cluster_name user_name
  current_context=$(yq eval '.current-context' "${source_file}")
  if [[ -z "${current_context}" || "${current_context}" == "null" ]]; then
    echo "kubeconfig-add: ${source_file} has no current-context set" >&2
    return 1
  fi
  cluster_name=$(yq eval ".contexts[] | select(.name == \"${current_context}\") | .context.cluster" "${source_file}")
  user_name=$(yq eval ".contexts[] | select(.name == \"${current_context}\") | .context.user" "${source_file}")

  local server ca_data cert_data key_data insecure
  server=$(yq eval ".clusters[] | select(.name == \"${cluster_name}\") | .cluster.server" "${source_file}")
  ca_data=$(yq eval ".clusters[] | select(.name == \"${cluster_name}\") | .cluster.\"certificate-authority-data\"" "${source_file}")
  insecure=$(yq eval ".clusters[] | select(.name == \"${cluster_name}\") | .cluster.\"insecure-skip-tls-verify\"" "${source_file}")
  cert_data=$(yq eval ".users[] | select(.name == \"${user_name}\") | .user.\"client-certificate-data\"" "${source_file}")
  key_data=$(yq eval ".users[] | select(.name == \"${user_name}\") | .user.\"client-key-data\"" "${source_file}")

  if [[ -z "${cert_data}" || "${cert_data}" == "null" || -z "${key_data}" || "${key_data}" == "null" ]]; then
    echo "kubeconfig-add: no client-certificate-data/client-key-data in ${source_file} - only cert/key auth is supported, token/exec-based auth needs manual setup" >&2
    return 1
  fi

  [[ -n "${server_override}" ]] && server="${server_override}"

  chmod 700 "${dir}"

  local ca_path=""
  if [[ -n "${ca_data}" && "${ca_data}" != "null" ]]; then
    ca_path="${dir}/ca.crt"
    print -r -- "${ca_data}" | base64 --decode > "${ca_path}"
    chmod 644 "${ca_path}"
  fi

  local cert_path="${dir}/client.crt" key_path="${dir}/client.key"
  print -r -- "${cert_data}" | base64 --decode > "${cert_path}"
  print -r -- "${key_data}" | base64 --decode > "${key_path}"
  chmod 644 "${cert_path}"
  chmod 600 "${key_path}"

  {
    echo "apiVersion: v1"
    echo "kind: Config"
    echo "current-context: ${name}"
    echo "clusters:"
    echo "- name: ${name}"
    echo "  cluster:"
    echo "    server: \"${server}\""
    if [[ -n "${ca_path}" ]]; then
      echo "    certificate-authority: \"${ca_path}\""
    elif [[ "${insecure}" == "true" ]]; then
      echo "    insecure-skip-tls-verify: true"
    fi
    echo "contexts:"
    echo "- name: ${name}"
    echo "  context:"
    echo "    cluster: ${name}"
    echo "    user: ${name}"
    echo "users:"
    echo "- name: ${name}"
    echo "  user:"
    echo "    client-certificate: \"${cert_path}\""
    echo "    client-key: \"${key_path}\""
  } > "${dir}/config"
  chmod 600 "${dir}/config"

  if ! kubectl config view --kubeconfig "${dir}/config" >/dev/null 2>&1; then
    echo "kubeconfig-add: generated ${dir}/config does not parse - check it by hand" >&2
    return 1
  fi

  echo "Wrote ${dir}/config (context '${name}', server ${server})"
  if [[ -z "${ca_path}" && "${insecure}" != "true" ]]; then
    echo "kubeconfig-add: no CA certificate found - TLS verification may fail" >&2
  fi
  echo "Run \`kubeconfig-merge\` to add it to ~/.kube/config"
}

# Merge every ~/.kube/configs/*/config into ~/.kube/config, keeping the
# certificate-authority/client-certificate/client-key entries as file paths
# rather than embedding them - ~/.kube/config stays small and secret-free.
# The original downloaded kubeconfigs and any other files in each
# subdirectory are ignored; only the file literally named `config` (written
# by kubeconfig-add) is read.
kubeconfig-merge() {
  emulate -L zsh

  if ! command -v kubectl >/dev/null; then
    echo "kubeconfig-merge: kubectl not found on PATH" >&2
    return 1
  fi

  local configs_dir="${HOME}/.kube/configs"
  local target="${HOME}/.kube/config"
  local -a sources
  sources=("${configs_dir}"/*/config(N))

  if (( ${#sources[@]} == 0 )); then
    echo "kubeconfig-merge: no config files found under ${configs_dir}/*/config - run kubeconfig-add first" >&2
    return 1
  fi

  # Preserve whichever context was active, so merging in a new cluster does
  # not silently switch the current one.
  local previous_context=""
  if [[ -f "${target}" ]]; then
    previous_context=$(kubectl config view --kubeconfig "${target}" -o jsonpath='{.current-context}' 2>/dev/null)
  fi

  local kubeconfig_path
  kubeconfig_path=$(IFS=:; echo "${sources[*]}")

  local tmp
  tmp=$(mktemp "${target}.XXXXXX") || return 1
  # No --flatten: that would embed every cert/key inline again, which is
  # exactly what the per-cluster subdirectories exist to avoid.
  if ! KUBECONFIG="${kubeconfig_path}" kubectl config view > "${tmp}"; then
    rm -f "${tmp}"
    echo "kubeconfig-merge: kubectl config view failed" >&2
    return 1
  fi

  if [[ -n "${previous_context}" ]] \
     && KUBECONFIG="${tmp}" kubectl config get-contexts -o name 2>/dev/null | grep -qx -- "${previous_context}"; then
    KUBECONFIG="${tmp}" kubectl config use-context "${previous_context}" >/dev/null
  fi

  if [[ -f "${target}" ]]; then
    cp "${target}" "${target}.bak-$(date +%Y%m%dT%H%M%S)"
  fi

  chmod 600 "${tmp}"
  mv "${tmp}" "${target}"

  echo "Merged ${#sources[@]} cluster config(s) from ${configs_dir} into ${target}"
}

_kubeconfig_names() {
  local -a names
  names=("${HOME}"/.kube/configs/*(/N:t))
  compadd -- "${names[@]}"
}
(( $+functions[compdef] )) && compdef _kubeconfig_names kubeconfig-add
