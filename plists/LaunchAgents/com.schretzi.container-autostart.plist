<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Brings the container runtime and its service containers back after a boot,
    and re-renders the AdGuard Home zone when an address changed.

    An Agent, not a Daemon. apple/container's API server is itself a
    per-user LaunchAgent registered into gui/<uid>, the containers belong to
    that user, and the DNS refresh runs LocalKubernetes' playbook against the
    user's ~/.kube/config. A LaunchDaemon would have none of those.

    See Scripts/MacOS/container_autostart.py for what is actually broken after
    a reboot - the short version is that `container system start` registers its
    plist outside ~/Library/LaunchAgents, so launchd never loads it on its own,
    and apple/container has no restart policy for the containers either.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schretzi.container-autostart</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/container_autostart</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Exits after each run, so a bare <true/> here would make launchd
         restart it forever. -->
    <key>KeepAlive</key>
    <false/>

    <!-- The safety net, not the main mechanism: RunAtLoad covers the boot this
         exists for. This catches the rest - a container stopped and restarted
         by hand, a runtime that died mid-session, a `brew upgrade container`
         that left the registered API server pointing at a Cellar path that no
         longer exists.

         300 rather than the 60 com.schretzi.adguardhome-bind uses: that one is
         the only thing standing between a fresh container and having no
         resolver at all, while everything this does is either already done or
         not urgent. The script is a no-op unless something actually changed,
         but the no-op still costs a `container list` and a `kiac get
         clusters`. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Exits after each run, so launchd opens fresh files and newsyslog's
         rename-based rotation is safe. -->
    <key>StandardOutPath</key>
    <string>/Users/schretzi/Library/Logs/container-autostart.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/schretzi/Library/Logs/container-autostart.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
