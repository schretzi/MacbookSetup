<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kiac.vmnet-nat-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/vmnet_nat_refresh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <!-- Re-run whenever macOS rewrites its network configuration state
         (Wi-Fi/Ethernet switch, VPN connect/disconnect, DHCP renewal,
         etc.) - both files are touched on essentially any interface or
         route change. -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
        <string>/Library/Preferences/SystemConfiguration/NetworkInterfaces.plist</string>
    </array>
    <!-- Safety net in case a network change doesn't touch either watched
         file (observed to happen occasionally with fast Wi-Fi roaming) -
         re-check every 5 minutes regardless. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/vmnet_nat_refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vmnet_nat_refresh.err.log</string>
</dict>
</plist>
