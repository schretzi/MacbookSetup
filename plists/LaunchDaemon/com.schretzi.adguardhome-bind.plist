<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Keeps AdGuard Home's dns.bind_hosts following the kiac vmnet gateway.

    AdGuard Home cannot serve the vmnet from a wildcard bind (UDP replies to
    non-loopback IPv4-mapped clients never leave the host - see
    Scripts/MacOS/adguardhome_bind_refresh.sh for the measurements), so the
    addresses are named explicitly. 192.168.64.1 only exists while at least one
    container runs, and AdGuard Home refuses to start on an address it cannot
    bind, so the list has to follow the interface rather than be fixed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schretzi.adguardhome-bind</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/adguardhome_bind_refresh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <!-- Same watched files as com.schretzi.vmnet-nat-refresh: macOS rewrites
         them on essentially any interface or route change. -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
        <string>/Library/Preferences/SystemConfiguration/NetworkInterfaces.plist</string>
    </array>

    <!-- The real trigger, and why this is 60 rather than the 300 its sibling
         uses: the vmnet bridge appears when the first container starts, which
         is not a system network change and touches neither watched file. Until
         this runs, every container and node VM has no resolver - so the poll
         is the primary mechanism here, not the safety net. Anything that
         cannot wait a minute (the LocalKubernetes playbooks) calls the script
         directly through its NOPASSWD sudo rule. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Exits after each run, so it reopens these on every launch and a
         newsyslog rename in between is invisible to it. -->
    <key>StandardOutPath</key>
    <string>/Library/Logs/adguardhome-bind.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/adguardhome-bind.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
