<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    AdGuard Home, the resolver this machine runs (see Setup.md -> DNS).

    A LaunchDaemon rather than an agent because port 53 is privileged: launchd
    starts it as root so it can bind port 53.

    Logging follows CONVENTIONS.md only halfway, on purpose. AdGuard Home
    writes adguardhome.log itself (log.file in AdGuardHome.yaml) because it
    holds the fd open and cannot reopen after a newsyslog rename; its own
    rotation is left on for that file. StandardErrorPath below catches
    panics and anything before its logger is up, and that file is the one
    etc/newsyslog.d/adguardhome.conf rotates.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schretzi.adguardhome</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/adguardhome/AdGuardHome</string>
        <string>--no-check-update</string>
        <string>--config</string>
        <string>/opt/adguardhome/AdGuardHome.yaml</string>
        <string>--work-dir</string>
        <string>/opt/adguardhome</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/adguardhome.err.log</string>
</dict>
</plist>
