<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schretzi.localhost-alias</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/localhost_alias</string>
        <string>2-12</string>
        <string>100</string>
    </array>

    <!-- Runs once at boot and exits, so it reopens the log on every launch
         and a newsyslog rename in between is invisible to it. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Library/Logs/localhost-alias.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/localhost-alias.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
